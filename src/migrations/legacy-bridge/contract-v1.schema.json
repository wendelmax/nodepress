{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodepress.dev/contracts/legacy-export-v1.schema.json",
  "title": "NodePress Legacy Export Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "resource", "runId", "watermark", "items", "pageChecksum"],
  "properties": {
    "contractVersion": { "const": "1" },
    "resource": { "enum": ["pages", "posts", "media", "users", "animals", "volunteers"] },
    "runId": { "type": "string", "minLength": 1 },
    "watermark": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["legacyId", "updatedAt", "payload"],
        "properties": {
          "legacyId": { "type": "string", "minLength": 1 },
          "updatedAt": { "type": "string", "format": "date-time" },
          "payload": { "type": "object" }
        }
      }
    },
    "nextCursor": { "type": "string", "minLength": 1 },
    "pageChecksum": { "type": "string", "minLength": 1 }
  }
}
