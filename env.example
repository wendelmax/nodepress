# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/nodepress?schema=public"
NEXTAUTH_SECRET="your-super-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Authentication mode: local (default), keycloak, or hybrid.
AUTH_MODE="local"

# Optional Keycloak / Navant ID authentication. Required only for keycloak/hybrid.
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8180"
AUTH_KEYCLOAK_REALM="master"
AUTH_KEYCLOAK_ID="nodepress"
AUTH_KEYCLOAK_SECRET="your-keycloak-client-secret"

# Optional Admissions service integration
ADMISSIONS_SVC_URL="http://admissions:8103"
TENANT_ID="your-tenant-id"
INTERNAL_SERVICE_REALM="master"
INTERNAL_SERVICE_CLIENT_ID="nodepress-service"
INTERNAL_SERVICE_CLIENT_SECRET="your-service-client-secret"

# Optional scheduled-post publishing endpoint
CRON_SECRET="your-cron-secret"
