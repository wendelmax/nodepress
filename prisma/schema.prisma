// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int          @id @default(autoincrement())
  userLogin           String       @map("user_login") @db.VarChar(60) @unique
  userPass            String       @map("user_pass") @db.VarChar(255)
  userNicename        String       @map("user_nicename") @db.VarChar(50) @unique
  userEmail           String       @map("user_email") @db.VarChar(100) @unique
  userUrl             String       @map("user_url") @db.VarChar(100)
  userRegistered      DateTime     @default(now()) @map("user_registered")
  userActivationKey   String       @map("user_activation_key") @db.VarChar(255)
  userStatus          Int          @default(0) @map("user_status")
  displayName         String       @map("display_name") @db.VarChar(250)
  keycloakSub         String?      @map("keycloak_sub") @db.VarChar(255) @unique

  meta                UserMeta[]
  posts               Post[]
  comments            Comment[]

  @@map("np_users")
}

model UserMeta {
  umetaId   Int     @id @default(autoincrement()) @map("umeta_id")
  userId    Int     @map("user_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.Text

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([metaKey])
  @@map("np_usermeta")
}

model Post {
  id                  Int          @id @default(autoincrement())
  postAuthor          Int          @map("post_author")
  postDate            DateTime     @default(now()) @map("post_date")
  postDateGmt         DateTime     @default(now()) @map("post_date_gmt")
  postContent         String       @map("post_content") @db.Text
  postTitle           String       @map("post_title") @db.Text
  postExcerpt         String       @map("post_excerpt") @db.Text
  postStatus          String       @default("publish") @map("post_status") @db.VarChar(20)
  commentStatus       String       @default("open") @map("comment_status") @db.VarChar(20)
  pingStatus          String       @default("open") @map("ping_status") @db.VarChar(20)
  postPassword        String       @map("post_password") @db.VarChar(255)
  postName            String       @map("post_name") @db.VarChar(200)
  toPing              String       @map("to_ping") @db.Text
  pinged              String       @map("pinged") @db.Text
  postModified        DateTime     @default(now()) @map("post_modified")
  postModifiedGmt     DateTime     @default(now()) @map("post_modified_gmt")
  postContentFiltered String       @map("post_content_filtered") @db.Text
  postParent          Int?         @map("post_parent")
  guid                String       @map("guid") @db.VarChar(255)
  menuOrder           Int          @default(0) @map("menu_order")
  postType            String       @default("post") @map("post_type") @db.VarChar(20)
  postMimeType        String       @map("post_mime_type") @db.VarChar(100)
  commentCount        Int          @default(0) @map("comment_count")

  author              User         @relation(fields: [postAuthor], references: [id])
  parent              Post?        @relation("PostToPost", fields: [postParent], references: [id])
  children            Post[]       @relation("PostToPost")
  meta                PostMeta[]
  comments            Comment[]

  @@index([postName])
  @@index([postType, postStatus, postDate, id])
  @@index([postParent])
  @@index([postAuthor])
  @@map("np_posts")
}

model PostMeta {
  metaId    Int     @id @default(autoincrement()) @map("meta_id")
  postId    Int     @map("post_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.Text

  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([metaKey])
  @@map("np_postmeta")
}

model Comment {
  commentId          Int        @id @default(autoincrement()) @map("comment_ID")
  commentPostId      Int        @map("comment_post_ID")
  commentAuthor      String     @map("comment_author") @db.Text
  commentAuthorEmail String     @map("comment_author_email") @db.VarChar(100)
  commentAuthorUrl   String     @map("comment_author_url") @db.VarChar(200)
  commentAuthorIp    String     @map("comment_author_IP") @db.VarChar(100)
  commentDate        DateTime   @default(now()) @map("comment_date")
  commentDateGmt     DateTime   @default(now()) @map("comment_date_gmt")
  commentContent     String     @map("comment_content") @db.Text
  commentKarma       Int        @default(0) @map("comment_karma")
  commentApproved    String     @default("1") @map("comment_approved") @db.VarChar(20)
  commentAgent       String     @map("comment_agent") @db.VarChar(255)
  commentType        String     @default("comment") @map("comment_type") @db.VarChar(20)
  commentParent      Int?       @map("comment_parent")
  userId             Int?       @map("user_id")

  post               Post       @relation(fields: [commentPostId], references: [id], onDelete: Cascade)
  user               User?      @relation(fields: [userId], references: [id])
  parent             Comment?   @relation("CommentToComment", fields: [commentParent], references: [commentId])
  children           Comment[]  @relation("CommentToComment")
  meta               CommentMeta[]

  @@index([commentPostId])
  @@index([commentApproved, commentDateGmt])
  @@index([commentDateGmt])
  @@index([commentParent])
  @@index([commentAuthorEmail])
  @@map("np_comments")
}

model CommentMeta {
  metaId    Int     @id @default(autoincrement()) @map("meta_id")
  commentId Int     @map("comment_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.Text

  comment   Comment @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

  @@index([commentId])
  @@index([metaKey])
  @@map("np_commentmeta")
}

model Term {
  termId    Int        @id @default(autoincrement()) @map("term_id")
  name      String     @map("name") @db.VarChar(200)
  slug      String     @map("slug") @db.VarChar(200)
  termGroup Int        @default(0) @map("term_group")

  taxonomies TermTaxonomy[]
  meta       TermMeta[]

  @@index([slug])
  @@index([name])
  @@map("np_terms")
}

model TermTaxonomy {
  termTaxonomyId Int    @id @default(autoincrement()) @map("term_taxonomy_id")
  termId         Int    @map("term_id")
  taxonomy       String @map("taxonomy") @db.VarChar(32)
  description    String @map("description") @db.Text
  parent         Int?   @map("parent")
  count          Int    @default(0) @map("count")

  term           Term   @relation(fields: [termId], references: [termId], onDelete: Cascade)
  relationships  TermRelationship[]

  @@unique([termId, taxonomy])
  @@index([taxonomy])
  @@map("np_term_taxonomy")
}

model TermRelationship {
  objectId       Int @map("object_id")
  termTaxonomyId Int @map("term_taxonomy_id")
  termOrder      Int @default(0) @map("term_order")

  termTaxonomy   TermTaxonomy @relation(fields: [termTaxonomyId], references: [termTaxonomyId], onDelete: Cascade)

  @@id([objectId, termTaxonomyId])
  @@index([termTaxonomyId])
  @@map("np_term_relationships")
}

model TermMeta {
  metaId    Int     @id @default(autoincrement()) @map("meta_id")
  termId    Int     @map("term_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.Text

  term      Term    @relation(fields: [termId], references: [termId], onDelete: Cascade)

  @@index([termId])
  @@index([metaKey])
  @@map("np_termmeta")
}

model Option {
  optionId    Int    @id @default(autoincrement()) @map("option_id")
  optionName  String @map("option_name") @db.VarChar(191) @unique
  optionValue String @map("option_value") @db.Text
  autoload    String @default("yes") @map("autoload") @db.VarChar(20)

  @@index([autoload])
  @@map("np_options")
}

model AnalyticsEvent {
  id           Int      @id @default(autoincrement())
  sessionId    String   @map("session_id") @db.VarChar(255)
  path         String   @map("path") @db.Text
  isNewVisitor Boolean  @default(false) @map("is_new_visitor")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("np_analytics_events")
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  formId    String   @map("form_id") @db.VarChar(100)
  payload   String   @map("payload") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  status    String   @default("unread") @map("status") @db.VarChar(50)

  @@index([formId])
  @@index([createdAt])
  @@map("np_form_submissions")
}

model PluginMigration {
  id            Int      @id @default(autoincrement())
  pluginId      String   @map("plugin_id") @db.VarChar(100)
  migrationId   String   @map("migration_id") @db.VarChar(150)
  checksum      String   @db.VarChar(128)
  pluginVersion String   @map("plugin_version") @db.VarChar(50)
  appliedAt     DateTime @default(now()) @map("applied_at")

  @@unique([pluginId, migrationId])
  @@index([pluginId])
  @@map("np_plugin_migrations")
}

model PluginStorage {
  id         Int      @id @default(autoincrement())
  pluginId   String   @map("plugin_id") @db.VarChar(100)
  storageKey String   @map("storage_key") @db.VarChar(191)
  value      Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([pluginId, storageKey])
  @@index([pluginId])
  @@map("np_plugin_storage")
}

model ContentTypeDefinition {
  id        String   @id @db.VarChar(100)
  label     String   @db.VarChar(180)
  version   String   @db.VarChar(50)
  fields    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("np_content_types")
}

model ContentRecord {
  id          String   @id @default(cuid()) @db.VarChar(30)
  contentType String   @map("content_type") @db.VarChar(100)
  tenantId    String?  @map("tenant_id") @db.VarChar(100)
  title       String   @db.VarChar(255)
  slug        String   @db.VarChar(255)
  status      String   @default("draft") @db.VarChar(20)
  data        Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([contentType, tenantId, slug])
  @@index([contentType, status])
  @@index([tenantId])
  @@map("np_content_records")
}

model PayloadImportRecord {
  id         String   @id @default(cuid()) @db.VarChar(30)
  source     String   @db.VarChar(100)
  collection String   @db.VarChar(150)
  sourceId   String   @map("source_id") @db.VarChar(255)
  targetId   String   @map("target_id") @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(100)
  slug       String   @db.VarChar(255)
  importedAt DateTime @default(now()) @map("imported_at")

  @@unique([source, collection, sourceId])
  @@index([targetType, targetId])
  @@map("np_import_records")
}

model BuilderTarget {
  id          String   @id @default(cuid()) @db.VarChar(30)
  targetType  String   @map("target_type") @db.VarChar(20)
  targetKey   String   @map("target_key") @db.VarChar(191)
  document    Json
  version     Int      @default(0)
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  revisions   BuilderRevision[]
  comments    BuilderComment[]
  auditEvents BuilderAuditEvent[]

  @@unique([targetType, targetKey])
  @@index([targetType, targetKey])
  @@map("np_builder_targets")
}

model BuilderRevision {
  id                   String         @id @default(cuid()) @db.VarChar(30)
  targetId             String         @map("target_id") @db.VarChar(30)
  version              Int
  document             Json
  createdById          Int            @map("created_by_id")
  note                 String?        @db.Text
  restoredFromRevisionId String?      @map("restored_from_revision_id") @db.VarChar(30)
  createdAt            DateTime       @default(now()) @map("created_at")

  target               BuilderTarget  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  comments             BuilderComment[]

  @@unique([targetId, version])
  @@index([targetId, createdAt])
  @@map("np_builder_revisions")
}

model BuilderComment {
  id          String          @id @default(cuid()) @db.VarChar(30)
  targetId    String          @map("target_id") @db.VarChar(30)
  revisionId  String?         @map("revision_id") @db.VarChar(30)
  anchor      String?         @db.VarChar(255)
  body        String          @db.Text
  status      String          @default("open") @db.VarChar(20)
  createdById Int             @map("created_by_id")
  resolvedById Int?          @map("resolved_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  resolvedAt  DateTime?       @map("resolved_at")

  target      BuilderTarget   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  revision    BuilderRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([targetId, status, createdAt])
  @@index([revisionId])
  @@map("np_builder_comments")
}

model BuilderAuditEvent {
  id           String         @id @default(cuid()) @db.VarChar(30)
  targetId     String?        @map("target_id") @db.VarChar(30)
  action       String         @db.VarChar(80)
  actorId      Int?           @map("actor_id")
  fromVersion  Int?           @map("from_version")
  toVersion    Int?           @map("to_version")
  revisionId   String?        @map("revision_id") @db.VarChar(30)
  commentId    String?        @map("comment_id") @db.VarChar(30)
  requestId    String         @map("request_id") @db.VarChar(100)
  metadata     Json
  createdAt    DateTime       @default(now()) @map("created_at")

  target       BuilderTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@index([targetId, createdAt])
  @@index([action, createdAt])
  @@map("np_builder_audit_events")
}

model BuilderPattern {
  id            String                  @id @default(cuid()) @db.VarChar(30)
  slug          String                  @unique @db.VarChar(120)
  name          String                  @db.VarChar(120)
  description   String                  @db.Text
  kind          String                  @db.VarChar(20)
  category      String                  @db.VarChar(80)
  tags          Json
  engine        String                  @db.VarChar(50)
  schemaVersion Int                     @map("schema_version")
  version       Int                     @default(1)
  document      Json
  archivedAt    DateTime?               @map("archived_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  versions      BuilderPatternVersion[]

  @@index([kind, category, archivedAt])
  @@index([archivedAt])
  @@map("np_builder_patterns")
}

model BuilderPatternVersion {
  id            String        @id @default(cuid()) @db.VarChar(30)
  patternId     String        @map("pattern_id") @db.VarChar(30)
  version       Int
  manifest      Json
  document      Json
  createdAt     DateTime      @default(now()) @map("created_at")
  pattern       BuilderPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, version])
  @@index([patternId, version])
  @@map("np_builder_pattern_versions")
}

model ThemeTemplate {
  id          String                @id @default(cuid()) @db.VarChar(30)
  slug        String                @db.VarChar(120)
  themeSlug   String                @map("theme_slug") @db.VarChar(80)
  area        String                @db.VarChar(20)
  name        String                @db.VarChar(120)
  conditions  Json
  priority    Int                   @default(0)
  enabled     Boolean               @default(false)
  version     Int                   @default(1)
  document    Json
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  versions    ThemeTemplateVersion[]

  @@unique([themeSlug, slug])
  @@index([themeSlug, area, enabled])
  @@map("np_theme_templates")
}

model ThemeTemplateVersion {
  id         String        @id @default(cuid()) @db.VarChar(30)
  templateId String        @map("template_id") @db.VarChar(30)
  version    Int
  document   Json
  createdAt  DateTime      @default(now()) @map("created_at")
  template   ThemeTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, version])
  @@map("np_theme_template_versions")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorUserId   Int?     @map("actor_user_id")
  tenantId      String?  @map("tenant_id") @db.VarChar(100)
  action        String   @db.VarChar(120)
  resourceType  String   @map("resource_type") @db.VarChar(80)
  resourceId    String?  @map("resource_id") @db.VarChar(120)
  success       Boolean  @default(true)
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  ipSummary     String?  @map("ip_summary") @db.VarChar(80)
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([occurredAt, id])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([actorUserId])
  @@index([tenantId])
  @@index([success])
  @@map("np_audit_logs")
}

model SearchDocument {
  id          String    @id @default(cuid()) @db.VarChar(30)
  sourceKey   String    @unique @map("source_key") @db.VarChar(255)
  kind        String    @db.VarChar(30)
  type        String    @db.VarChar(100)
  sourceId    String    @map("source_id") @db.VarChar(100)
  tenantId    String?   @map("tenant_id") @db.VarChar(100)
  title       String    @db.Text
  slug        String    @db.VarChar(255)
  body        String    @db.Text
  excerpt     String    @db.Text
  url         String    @db.VarChar(500)
  status      String    @db.VarChar(20)
  authorId    Int?      @map("author_id")
  categories  Json
  tags        Json
  publishedAt DateTime? @map("published_at")
  indexedAt   DateTime  @default(now()) @updatedAt @map("indexed_at")

  @@index([tenantId])
  @@index([kind, type, status])
  @@index([sourceId])
  @@map("np_search_documents")
}
